# Environment variables for the AI-Powered GitHub PR Reviewer backend.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# See CLAUDE.md §9.

# Required: Groq API key for AI inference.
GROQ_API_KEY=your_groq_api_key

# Required: Groq model id to use for reviews.
# Must be a model that supports JSON mode (response_format=json_object);
# otherwise review requests fail with a 502. See CLAUDE.md §7.
GROQ_MODEL=your_selected_model

# Optional for the public-repository MVP. Leave empty for unauthenticated
# GitHub access; set a token to raise GitHub API rate limits.
GITHUB_TOKEN=
